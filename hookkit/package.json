{
  "name": "@creait/dsh-hookkit",
  "description": "Config-driven lifecycle hooks for DeepSeek Harness, including context injection: declare event -> handler -> outcome in cordis.patch.yml",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./config": {
      "default": "./lib/config.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/config.js",
    "lib/handlers.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "hooks",
    "lifecycle",
    "context-injection",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CREAIT-nl/dsh-plugins.git",
    "directory": "hookkit"
  },
  "homepage": "https://github.com/CREAIT-nl/dsh-plugins/tree/main/hookkit#readme",
  "bugs": {
    "url": "https://github.com/CREAIT-nl/dsh-plugins/issues"
  },
  "author": "Francesco G <francesco@creait.nl>"
}
