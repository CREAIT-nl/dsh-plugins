{
  "name": "@creait/dsh-web-fetch",
  "description": "Guarded local fetch provider for the DeepSeek Harness web capability seam (ctx.web) \u2014 the backend dsh's shipped web_fetch tool is missing",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./addr": {
      "default": "./lib/addr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/addr.js"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-web": "^0.1.0-rc.7",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "web-fetch",
    "ssrf",
    "self-hosted"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CREAIT-nl/dsh-plugins.git",
    "directory": "web-fetch"
  },
  "homepage": "https://github.com/CREAIT-nl/dsh-plugins/tree/main/web-fetch#readme",
  "bugs": {
    "url": "https://github.com/CREAIT-nl/dsh-plugins/issues"
  },
  "author": "Francesco G <francesco@creait.nl>"
}
